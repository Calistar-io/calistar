{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".vitepress/dist/**"],
      "env": ["DOCS_ORIGIN", "CONSOLE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "env": ["DOCS_ORIGIN", "CONSOLE_URL"],
      "cache": false,
      "persistent": true
    }
  }
}
