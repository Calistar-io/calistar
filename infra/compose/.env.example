# Local values for the proof-of-concept stack. Copy to .env to change them.
# The defaults built into compose.yaml are for a developer machine only: every published port
# is bound to 127.0.0.1. Never reuse them on a reachable host.

# Port of the reverse proxy on this machine: the only public entry point.
PUBLIC_PORT=8080

POSTGRES_PASSWORD=local-postgres
UMAMI_DB_PASSWORD=local-umami
CALISTAR_DB_PASSWORD=local-calistar

# Umami: secret used to sign its tokens. Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=local-only-app-secret-change-me-0000000000000000000000000000000000
